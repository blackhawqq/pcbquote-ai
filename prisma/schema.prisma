// PCBQuote AI — PostgreSQL schema (Neon / Vercel Postgres)
// Local dev: use SQLite by setting DATABASE_URL=file:./dev.db and provider="sqlite"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER & AUTH ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          String    @default("USER")
  companyName   String?
  phone         String?
  country       String?
  timezone      String    @default("UTC")
  currency      String    @default("USD")
  language      String    @default("en")

  stripeCustomerId String? @unique

  quotesThisMonth Int      @default(0)
  quotesResetAt   DateTime @default(now())

  accounts      Account[]
  sessions      Session[]
  quotes        Quote[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SUBSCRIPTION ─────────────────────────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String   @unique
  stripePriceId        String
  plan                 String   @default("FREE")
  status               String   @default("INACTIVE")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  canceledAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PCB QUOTE ────────────────────────────────────────────────────────────────

model Quote {
  id          String @id @default(cuid())
  userId      String
  status      String @default("PENDING")
  referenceNo String @unique @default(cuid())

  width           Float
  height          Float
  layers          Int     @default(2)
  thickness       Float   @default(1.6)
  copperWeight    Float   @default(1.0)
  surfaceFinish   String  @default("HASL")
  solderMaskColor String  @default("GREEN")
  silkscreenColor String  @default("WHITE")
  viaCount        Int     @default(0)
  drillCount      Int     @default(0)
  minTraceWidth   Float   @default(0.15)
  minSpacing      Float   @default(0.15)
  quantity        Int     @default(10)
  panelization    Boolean @default(false)
  panelRows       Int?
  panelCols       Int?

  smtAssembly         Boolean @default(false)
  throughHoleAssembly Boolean @default(false)
  componentCount      Int     @default(0)
  smtComponentCount   Int     @default(0)
  thComponentCount    Int     @default(0)

  electricalTest  Boolean @default(false)
  aoiInspection   Boolean @default(false)
  xrayInspection  Boolean @default(false)

  fileUrl   String?
  fileName  String?
  fileSize  Int?

  materialCost      Float?
  manufacturingCost Float?
  assemblyCost      Float?
  testingCost       Float?
  packagingCost     Float?
  shippingCost      Float?
  totalCost         Float?
  suggestedPrice    Float?
  profitMargin      Float?
  leadTimeDays      Int?
  yieldEstimate     Float?
  complexityScore   Int?
  dfmScore          Int?

  // Stored as JSON strings in SQLite
  dfmWarnings             String @default("[]")
  manufacturingNotes      String @default("[]")
  optimizationSuggestions String @default("[]")
  riskAnalysis            String @default("{}")

  currency       String  @default("USD")
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  customerNotes  String?
  internalNotes  String?

  // AI market research result (JSON string)
  aiAnalysis     String @default("{}")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([referenceNo])
}

// ─── API KEYS ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  permissions String    @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── INVOICE ──────────────────────────────────────────────────────────────────

model Invoice {
  id              String  @id @default(cuid())
  userId          String
  stripeInvoiceId String  @unique
  amount          Float
  currency        String
  status          String
  pdfUrl          String?
  invoiceUrl      String?
  periodStart     DateTime
  periodEnd       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  quoteId   String?
  action    String
  metadata  String? // JSON string
  ipAddress String?
  userAgent String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── GLOBAL SETTINGS ──────────────────────────────────────────────────────────

model GlobalSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON string

  updatedAt DateTime @updatedAt
}
